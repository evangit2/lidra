{
  "name": "lidra",
  "productName": "Lidra",
  "version": "1.7.4",
  "description": "Lidra — an elegant Apple Music desktop client with a native high-quality audio pipeline, forked from Lidra.",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node scripts/inject-lastfm-credentials.cjs",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:audio": "electron test/e2e/quality-report.cjs",
    "test:multichannel": "electron test/e2e/multichannel-playback.cjs",
    "test:playback": "electron test/e2e/audio-playback.cjs",
    "probe:widevine": "electron test/e2e/widevine-probe.cjs",
    "probe:atmos": "electron test/e2e/atmos-integrity.cjs",
    "probe:badge": "electron test/e2e/quality-badge.cjs",
    "verify:ffmpeg": "node scripts/verify-packaged-ffmpeg.cjs"
  },
  "author": "Martin Wimpress <code@wimpress.io>",
  "homepage": "https://github.com/evangit2/lidra",
  "license": "BlueOak-1.0.0",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "typescript": "^7.x",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@holusion/dbus-next": "^0.11.2",
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.x",
    "electron-updater": "^6.8.12",
    "ffmpeg-static": "^5.3.0"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch@>=7 <11.0.1": "11.0.1"
    },
    "app-builder-lib": {
      "minimatch@>=7 <11.0.1": "11.0.1"
    },
    "brace-expansion": ">=5.0.6",
    "undici": "7.30.1"
  },
  "build": {
    "appId": "io.github.evangit2.lidra",
    "copyright": "Copyright (c) Martin Wimpress",
    "publish": {
      "provider": "github",
      "owner": "evangit2",
      "repo": "lidra"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/icons/**",
      "assets/lastfm-credentials.json",
      "assets/locales/about.json",
      "assets/locales/loading.json",
      "assets/locales/tray.json",
      "assets/locales/update.json",
      "assets/fastPlaylistQueue.js",
      "assets/musicKitHook.js",
      "assets/lidraDrm.js",
      "assets/navigationBar.js",
      "assets/settings.html",
      "assets/settings.css",
      "assets/settings.js",
      "assets/about.html",
 "assets/fairplayLogin.html",
      "assets/authFrameFix.js",
      "assets/authStyleFix.css",
      "assets/lidra-mark.png",
      "assets/splash.html",
      "assets/styleFix.css",
      "assets/windowChrome.css",
      "assets/qualityBadge.js",
      "node_modules/ffmpeg-static/**"
    ],
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/source/**"
    ],
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "flatpak",
        "snap"
      ],
      "category": "Audio",
      "executableName": "lidra",
      "desktop": {
        "entry": {
          "Actions": "PlayPause;Next;Previous;Stop;",
          "MimeType": "x-scheme-handler/itms;"
        },
        "desktopActions": {
          "PlayPause": {
            "Name": "Play-Pause",
            "Name[de]": "Abspielen-Pausieren",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.lidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause"
          },
          "Next": {
            "Name": "Next",
            "Name[de]": "Nächstes",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.lidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next"
          },
          "Previous": {
            "Name": "Previous",
            "Name[de]": "Vorheriges",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.lidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous"
          },
          "Stop": {
            "Name": "Stop",
            "Name[de]": "Stop",
            "Exec": "dbus-send --print-reply --dest=org.mpris.MediaPlayer2.lidra /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Stop"
          }
        }
      },
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "vendor/wrapper/opt/lidra",
          "to": "fairplay-payload"
        },
        {
          "from": "vendor/fairplay",
          "to": "fairplay"
        }
      ]
    },
    "protocols": [
      {
        "name": "Apple Music URL",
        "schemes": [
          "itms"
        ]
      }
    ],
    "appImage": {
      "artifactName": "${productName}-${os}-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "Martin Wimpress <code@wimpress.io>",
      "priority": "optional"
    },
    "rpm": {
      "vendor": "Martin Wimpress",
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "26.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "26.08",
      "branch": "stable",
      "files": [
        [
          "release/metainfo",
          "/share/metainfo"
        ]
      ],
      "finishArgs": [
        "--env=ZYPAK_ZYGOTE_STRATEGY_SPAWN=0",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--own-name=org.mpris.MediaPlayer2.lidra",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher"
      ]
    },
    "snapcraft": {
      "base": "core24",
      "core24": {
        "confinement": "strict",
        "grade": "stable",
        "summary": "An elegant Apple Music desktop client",
        "plugs": [
          "default",
          "browser-support",
          "removable-media"
        ],
        "slots": [
          {
            "mpris": {
              "name": "lidra"
            }
          }
        ],
        "environment": {
          "TMPDIR": "$XDG_RUNTIME_DIR"
        },
        "publish": false
      }
    },
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 140,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/wrapper-tar/wrapper-rootfs.tar.gz",
          "to": "wrapper/wrapper-rootfs.tar.gz"
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "desktopName": "lidra.desktop"
}
